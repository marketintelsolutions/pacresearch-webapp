# Non-secret Functions params. Copy to .env and fill in.
# Secrets (PAYSTACK_SECRET_KEY, EMAIL_API_KEY) are NOT set here — use:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY

# Preferred: a Paystack Transaction Split code (75% PAC Research / 25% Ziltch1).
PAYSTACK_SPLIT_CODE=

# Fallback if no split code: a single Ziltch1 subaccount code.
ZILTCH_SUBACCOUNT_CODE=

# Where Paystack redirects after checkout (frontend callback route).
PAYSTACK_CALLBACK_URL=https://pacresearch.org/report-archive/payment-callback

# Public site origin, used for links in notification emails.
SITE_ORIGIN=https://pacresearch.org
